{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/filler",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/filler/weather",
      "schedule": "15 */3 * * *"
    },
    {
      "path": "/api/cron/newsroom",
      "schedule": "5 * * * *"
    }
  ]
}
