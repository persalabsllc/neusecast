# Web control plane. Use the deployed NeuseCast origin; do not add /api here.
NEUSECAST_BASE_URL=https://neusecast.com
ALLOW_INSECURE_CONTROL_PLANE=false
BROADCAST_AGENT_SECRET=replace-with-a-long-random-shared-secret
BROADCAST_OUTPUT_KEY=main
BROADCAST_AGENT_ID=neusecast-playout-01

# CasparCG AMCP connection.
CASPAR_HOST=casparcg
CASPAR_PORT=5250
CASPAR_CHANNEL=1
CASPAR_PROGRAM_LAYER=10
CASPAR_GRAPHICS_LAYER=900
CASPAR_GRAPHICS_TEMPLATE=neusecast-overlay
CASPAR_FORMAT_FPS=30
CASPAR_FALLBACK_CLIP=NEUSECAST_FALLBACK

# The agent and CasparCG must mount the same media directory.
MEDIA_CACHE_DIR=/var/lib/casparcg/media
AGENT_STATE_DIR=/var/lib/neusecast-agent
MEDIA_MAX_FILE_BYTES=5368709120
MEDIA_CACHE_MAX_BYTES=21474836480
MEDIA_DOWNLOAD_TIMEOUT_MS=1800000
# 0 keeps retryable transport failures alive indefinitely with capped backoff.
MEDIA_INGEST_MAX_ATTEMPTS=0
MEDIA_INGEST_RETRY_BASE_MS=5000
MEDIA_INGEST_RETRY_MAX_MS=300000
MEDIA_INGEST_RETRY_TICK_MS=1000

# Polling, reporting, and local health endpoint.
SNAPSHOT_INTERVAL_MS=5000
COMMAND_INTERVAL_MS=1500
SCHEDULE_TICK_MS=200
PRELOAD_LEAD_MS=8000
HEARTBEAT_INTERVAL_MS=10000
EVENT_FLUSH_INTERVAL_MS=2000
GRAPHICS_CLOCK_SYNC_MS=30000
LIVE_SOURCE_PROBE_INTERVAL_MS=15000
LIVE_SOURCE_PROBE_TIMEOUT_MS=6000
API_TIMEOUT_MS=10000
LOCAL_HEALTH_HOST=0.0.0.0
LOCAL_HEALTH_PORT=8787

# Supervised stream-relay output. Leave STREAM_OUTPUT_URL empty until a
# Cloudflare Live Input exists. STREAM_PROTOCOL may be rtmps or srt.
STREAM_PROTOCOL=rtmps
STREAM_OUTPUT_URL=

# OBS contribution gateway. Keep loopback for a same-computer OBS test. Set the
# bind address to the playout PC's private LAN IP only when the studio OBS
# computer needs to publish across the local network. Never expose these ports
# directly to the public Internet.
MEDIAMTX_BIND_ADDRESS=127.0.0.1
MEDIAMTX_PUBLISH_USER=neusecast-publisher
MEDIAMTX_PUBLISH_PASSWORD=replace-with-a-long-random-password

# A live source can reference a complete secret source URL without storing it
# in the database: credentialSecretRef="env:STUDIO_CAMERA_SOURCE_URL".
# STUDIO_CAMERA_SOURCE_URL=srt://encoder.example:9000?streamid=replace-me
