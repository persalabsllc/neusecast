# Broadcast Studio control plane. Keep the Cloudflare ingest URL only in the
# persistent playout host's broadcast-agent/.env file.
BROADCAST_AGENT_SECRET=
BROADCAST_CLOUDFLARE_CONFIGURED=false
NEXT_PUBLIC_BROADCAST_HLS_URL=

# Advertiser billing (Stripe)
