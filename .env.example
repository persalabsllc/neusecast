# Automation
CRON_SECRET=
OPENAI_API_KEY=
OPENAI_FILLER_MODEL=gpt-5.6-luna
OPENAI_NEWSROOM_MODEL=gpt-5.6-luna
NEWSROOM_MINIMUM_GAP_MINUTES=55
